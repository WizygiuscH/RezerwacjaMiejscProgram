{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build rezerwacje",
      "type": "shell",
      "command": "g++",
      "args": [
        "-g",
        "-Iinclude",
        "src/main.cpp", "src/Miejsce.cpp", "src/Rezerwacja.cpp",
        "src/Obiekt.cpp", "src/Autobus.cpp", "src/Kino.cpp", "src/Stadion.cpp",
        "src/SystemRezerwacji.cpp",
        "-o", "rezerwacje"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true }
    }
  ]
}
